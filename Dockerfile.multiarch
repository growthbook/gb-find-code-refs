# Cross-compiles from source so the image manifest and the binary inside it always agree.
FROM --platform=$BUILDPLATFORM golang:1.20-alpine AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -mod=vendor -ldflags="-s -w" -o /out/gb-find-code-refs ./cmd/gb-find-code-refs

FROM alpine:3.19.0
RUN apk add --no-cache git openssh
COPY --from=build /out/gb-find-code-refs /usr/local/bin/gb-find-code-refs
ENTRYPOINT ["gb-find-code-refs"]
